// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum InterviewType {
  CODING
  BEHAVIORAL
  SYSTEM_DESIGN
  RESUME_BASED
  DOMAIN_SPECIFIC
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SeniorityLevel {
  ENTRY
  JUNIOR
  INTERMEDIATE
  SENIOR
  STAFF
  PRINCIPAL
}

enum CompanyTier {
  STARTUP
  MID_MARKET
  FAANG
}

enum ProgrammingLanguage {
  PYTHON
  JAVA
  JAVASCRIPT
  TYPESCRIPT
  CPP
  GO
  RUST
}

enum TestCaseVisibility {
  PUBLIC
  HIDDEN
  CUSTOM
}

enum SubmissionResult {
  PASSED
  FAILED
  PARTIAL
  ERROR
  TIMEOUT
}

enum Verdict {
  STRONG_HIRE
  HIRE
  LEAN_HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(CANDIDATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  bio String?

  banned       Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?

  sessions Session[]
  accounts Account[]
  settings Settings?
  resume   Resume?

  interviews         Interview[] @relation("CandidateInterviews")
  assignedInterviews Interview[] @relation("RecruiterAssignedInterviews")
  practiceAttempts   PracticeAttempt[]

  sentInvites     RecruiterInvite[] @relation("SentInvites")
  receivedInvites RecruiterInvite[] @relation("ReceivedInvites")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Settings {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean           @default(true)
  profileVisibility  ProfileVisibility @default(PRIVATE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("settings")
}

model Question {
  id             String          @id @default(cuid())
  type           InterviewType
  title          String
  prompt         String
  difficulty     Difficulty
  seniorityLevel SeniorityLevel?
  companyTier    CompanyTier?
  topics         String[]
  createdAt      DateTime        @default(now())

  interviewQuestions InterviewQuestion[]
  testCases           TestCase[]
  practiceAttempts    PracticeAttempt[]

  @@index([type])
  @@index([difficulty])
  @@map("question")
}

model TestCase {
  id             String             @id @default(cuid())
  questionId     String
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  visibility     TestCaseVisibility @default(PUBLIC)
  createdAt      DateTime           @default(now())

  @@index([questionId])
  @@map("test_case")
}

model Interview {
  id             String          @id @default(cuid())
  title          String?
  type           InterviewType
  status         InterviewStatus @default(SCHEDULED)
  difficulty     Difficulty
  seniorityLevel SeniorityLevel
  companyTier    CompanyTier?
  language       ProgrammingLanguage?

  candidateId String
  candidate   User    @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)

  assignedByRecruiterId String?
  assignedByRecruiter   User?   @relation("RecruiterAssignedInterviews", fields: [assignedByRecruiterId], references: [id], onDelete: SetNull)

  questions InterviewQuestion[]

  startedAt DateTime?
  endedAt   DateTime?
  timeLimitMinutes Int @default(30)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  report Report?

  @@index([candidateId])
  @@index([assignedByRecruiterId])
  @@index([status])
  @@map("interview")
}

model PracticeAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  code             String?
  language         ProgrammingLanguage?
  behavioralAnswer String?

  result          SubmissionResult?
  aiFeedback      String?
  passedTestCases Int?
  totalTestCases  Int?
  executionTimeMs Int?
  memoryUsedKb    Int?

  hints     String[] @default([])
  hintLevel Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("practice_attempt")
}

model InterviewQuestion {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order       Int       @default(0)

  code             String?
  language         ProgrammingLanguage?
  behavioralAnswer String?

  result          SubmissionResult?
  passedTestCases Int?
  totalTestCases  Int?
  executionTimeMs Int?
  memoryUsedKb    Int?

  hints     String[] @default([])
  hintLevel Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, questionId])
  @@index([interviewId])
  @@map("interview_question")
}

model Report {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  overallScore   Int
  communication  Int?
  problemSolving Int?
  codeQuality    Int?
  optimization   Int?
  cleanliness    Int?
  confidence     Int?
  timeComplexity String?
  verdict        Verdict?
  suggestions    String[]
  topicScores    Json? 
  pdfUrl         String? 

  createdAt DateTime @default(now())

  @@map("report")
}

model Resume {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName            String
  fileUrl             String
  fileSize            Int
  parsedText          String?
  visibleToRecruiters Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback ResumeFeedback?

  @@map("resume")
}

model ResumeFeedback {
  id       String @id @default(cuid())
  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  atsScore      Int
  summary       String
  strengths     String[]
  weaknesses    String[]
  suggestions   String[]
  sectionScores Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resume_feedback")
}

model RecruiterInvite {
  id             String       @id @default(cuid())
  recruiterId    String
  recruiter      User         @relation("SentInvites", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateEmail String
  candidateId    String?
  candidate      User?        @relation("ReceivedInvites", fields: [candidateId], references: [id], onDelete: SetNull)
  status         InviteStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  @@index([recruiterId])
  @@index([candidateEmail])
  @@map("recruiter_invite")
}